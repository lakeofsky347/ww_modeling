10% Resonance Skill DMG Bonus to all active Resonators in the team. When any Resonator in the team casts Intro Skill during this state, Thunder Spell - Yin and Yang becomes Thunder Spell - Heaven, Earth, Mind.\n- Thunder Spell - Heaven, Earth, Mind grants 25% Resonance Skill DMG Bonus to all active Resonators in the team.\n\nMinor Yang and Minor Yin\n- Minor Yang is obtained after casting Heavy Attack - Mountain Over Thunder or Heavy Attack - Thunder Over Mountain.\n- Minor Yin is obtained after casting Heavy Attack - Twin Mountains or Heavy Attack - Twin Thunders.","params":[{"label":"飞雷诀·归一伤害","labelEn":"Flashing Thunder Spell - Harmony DMG","values":["270.00%","292.14%","314.28%","345.28%","367.42%","392.88%","428.31%","463.73%","499.15%","536.79%"]},{"label":"五雷荡煞阵持续伤害","labelEn":"Five Thunders Spell Array Continuous DMG","values":["10.00%","10.82%","11.64%","12.79%","13.61%","14.56%","15.87%","17.18%","18.49%","19.89%"]}],"hits":[{"label":"飞雷诀·归一伤害","labelEn":"Flashing Thunder Spell - Harmony DMG","term":0,"count":1,"multiplier":[2.7,2.9214,3.1428,3.4528,3.6742,3.9288,4.2831,4.6373,4.9915,5.3679],"damageId":1307019101,"type":"liberation","typeId":2,"typeName":"共鸣解放","calc":"damage","element":"electro","elementId":3,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[0.0],"concerto":[0.0],"elementPowerType":3,"toughness":[4.0],"offTune":[7.2],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1307019101],"confidence":"high"},{"label":"五雷荡煞阵持续伤害","labelEn":"Five Thunders Spell Array Continuous DMG","term":0,"count":1,"multiplier":[0.1,0.1082,0.1164,0.1279,0.1361,0.1456,0.1587,0.1718,0.1849,0.1989],"damageId":1307019002,"type":"liberation","typeId":2,"typeName":"共鸣解放","calc":"damage","element":"electro","elementId":3,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[0.0],"concerto":[0.0],"elementPowerType":3,"toughness":[0.5],"offTune":[0.0],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1307019002],"confidence":"high"}],"unlink