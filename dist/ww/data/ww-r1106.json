]}],"hits":[{"label":"技能伤害","labelEn":"Skill DMG","term":0,"count":1,"multiplier":[0.45,0.4869,0.5238,0.5755,0.6124,0.6548,0.7139,0.7729,0.832,0.8947],"damageId":1106300001,"type":"intro","typeId":3,"typeName":"变奏技能","calc":"damage","element":"glacio","elementId":1,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[4.5],"concerto":[0.0],"elementPowerType":1,"toughness":[0.5102],"offTune":[0.4083],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1106300001],"confidence":"high"},{"label":"技能伤害","labelEn":"Skill DMG","term":1,"count":1,"multiplier":[0.55,0.5951,0.6402,0.7034,0.7485,0.8004,0.8725,0.9447,1.0168,1.0935],"damageId":1106300002,"type":"intro","typeId":3,"typeName":"变奏技能","calc":"damage","element":"glacio","elementId":1,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[5.5],"concerto":[0.0],"elementPowerType":1,"toughness":[0.6235],"offTune":[0.499],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1106300002],"confidence":"high"}],"concertoGain":10.0,"confidence":"high","skillIcon":"assets/skills/1002406.webp?v=400640c143e8"},{"id":1002407,"type":6,"typeName":"共鸣回路","typeNameEn":"Forte Circuit","name":"诗中物","nameEn":"Poetic Essence","maxLevel":10,"desc":"釉瑚拥有四个【吉兆】时，长按普攻将施放诗中物，造成冷凝伤害，此次伤害为共鸣技能伤害，并且回复附近队伍中所有角色的生命值。\n釉瑚最多同时拥有四个【吉兆】。\n \n诗中物\n对范围敌人造成冷凝伤害，并且根据【吉兆】组合的不同获得以下的一种额外效果：\n·飞白：每种【吉兆】都拥有时。对命中的敌人造成额外共振值伤害。\n·对偶：拥有一对相同的【吉兆】时。诗中物造成的伤害提升70%。\n·双关：拥有两对相同的【吉兆】时。额外回复附近队伍中所有角色的生命值。\n·联珠：拥有三个相同的【吉兆】时。诗中物造成的伤害提升175%。\n·合说：拥有四个相同的【吉兆】时。同时触发飞白、双关、联珠的效果。\n施放诗中物后，清除所有【吉兆】。\n \n【吉兆】的获取规则\n·施放共鸣技能匣中问祯、变奏技能遂心匣、重击落霜坠、共鸣解放如意卜、闪避反击时，获得祯祥。\n·釉瑚拥有祯祥的状态下，点击普攻时，根据祯祥进行对应的奇珍赏，并获得对应的【吉兆】。","descEn":"At four Auspices, hold the Normal Attack button to release Poetic Essence, dealing Glacio DMG, considered as Resonance Skill DMG, while restoring HP for all nearby party members.\nYouhu can hold up to four Auspices.\n \nPoetic Essence\nDeal Glacio DMG to enemies within the range and additionally obtain one of the following effects based on the Auspice combination:\n- Free Verse: Four different types Auspices. Additionally reduce the Vibration Strength of hit enemies.\n- Antithesis: A pair of Auspices. Increase Poetic Essence's DMG by 70%.\n- Double Pun: Two pairs of Auspices. Additionally restore HP for all nearby party members.\n- Triplet: Three identical Auspices. Increase Poetic Essence's DMG by 175%.\n- Perfect Rhyme: Four identical Auspices. Simultaneously activate the effects of Free Verse, Double Pun, and Triplet.\nCasting Poetic Essence removes all Auspices.\n \nAuspice\n- Youhu gains an Auspice through Antique Appraisal. Use Basic Attack while holding an Antique to receive the corresponding Auspice.\n- Youhu unlocks Antiques by casting Resonance Skill Scroll Divination, Intro Skill Scroll of Wonders, Heavy Attack Frostfall, Resonance Liberation Fortune's Favor, and Dodge Counter.","params":[{"label":"诗中物技能伤害","labelEn":"Poetic Essence Skill DMG","values":["18.72%*10","20.26%*10","21.79%*10","23.94%*10","25.47%*10","27.24%*10","29.69%*10","32.15%*10","34.60%*10","37.21%*10"]},{"label":"诗中物治疗量","labelEn":"Poetic Essence Healing","values":["1180+44.20%","1243+45.97%","1317+47.74%","1475+50.39%","1665+53.92%","1844+57.46%","1876+64.09%","1918+71.60%","1949+79.56%","2002+92.82%"]},{"label":"双关额外治疗量","labelEn":"Double Pun Bonus Healing","values":["694+26.00%","731+27.04%","775+28.08%","868+29.64%","979+31.72%","1085+33.80%","1103+37.70%","1128+42.12%","1147+46.80%","1178+54.60%"]},{"label":"回复协奏能量","labelEn":"Concerto Regen","values":["20","20","20","20","20","20","20","20","20","20"]}],"hits":[{"label":"诗中物技能伤害","labelEn":"Poetic Essence Skill DMG","term":0,"count":10,"multiplier":[0.1872,0.2026,0.2179,0.2394,0.2547,0.2724,0.2969,0.3215,0.346,0.3721],"damageId":1106500001,"type":"skill","typeId":4,"typeName":"共鸣技能","calc":"damage","element":"glacio","elementId":1,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[1.0],"concerto":[0.0],"elementPowerType":1,"toughness":[0.2],"offTune":[0.04],"hardness