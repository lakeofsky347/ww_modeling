l","elementId":0,"scaling":"hp","rateField":"RateLv","flat":[130,141,152,167,177,190,207,224,241,259],"energy":[0.0],"concerto":[0.0],"elementPowerType":0,"toughness":[0.0],"offTune":[0.0],"hardness":[0.0],"formulaType":0,"subType":[],"damageIds":[1505600004],"confidence":"high"},{"label":"洞悉治疗量","labelEn":"Discernment Healing","term":0,"count":1,"multiplier":[0.0066,0.0072,0.0077,0.0085,0.009,0.0097,0.0105,0.0114,0.0123,0.0132],"flatAdd":[145.0,157.0,169.0,186.0,198.0,211.0,231.0,250.0,269.0,289.0],"damageId":1505600005,"type":"intro","typeId":3,"typeName":"变奏技能","calc":"heal","element":"physical","elementId":0,"scaling":"hp","rateField":"RateLv","flat":[145,157,169,186,198,211,231,250,269,289],"energy":[0.0],"concerto":[0.0],"elementPowerType":0,"toughness":[0.0],"offTune":[0.0],"hardness":[0.0],"formulaType":0,"subType":[],"damageIds":[1505600005],"confidence":"high"}],"concertoGain":20.0,"unlinkedDamage":[{"damageId":1505505011,"type":"liberation","typeId":2,"typeName":"共鸣解放","calc":"damage","element":"spectro","elementId":5,"scaling":"hp","rate":[0.1403,0.1518,0.1633,0.1794,0.1909,0.2041,0.2225,0.2409,0.2593,0.2789],"rateField":"RateLv","flat":null,"energy":[3.34],"concerto":[0.0],"elementPowerType":5,"toughness":[0.3334],"offTune":[2.4414],"hardness":[1.0],"formulaType":0,"subType":[],"confidence":"low","lowReason":"damage row not referenced by any description multiplier (conditional/variant hit or non-damage effect)"}],"confidence":"high","skillIcon":"assets/skills/1002506.webp?v=64bfed8a5a95"},{"id":1002507,"type":6,"typeName":"共鸣回路","typeNameEn":"Forte Circuit","name":"群星漫响","nameEn":"Astral Chord","maxLevel":10,"desc":"耀星·蝶\n常态攻击命中目标时，生成坍缩核悬浮在空中，并在6秒后演化为耀星·蝶。耀星·蝶将自动追踪目标，造成衍射伤害。若场上坍缩核的数量已达到5枚，守岸人下一次普攻会催生坍缩核，使之提前演化为耀星·蝶。\n \n演绎\n持有5段【实论数据】时，施放重击将消耗所有【实论数据】，牵引周围的目标，造成衍射伤害，并使所有坍缩核立即演化为耀星·蝶。\n \n衍变\n持有5段【实论数据】时，施放空中攻击将消耗所有【实论数据】，造成衍射伤害，并使所有坍缩核立即演化为耀星·蝶。一定时间内短按普攻将会施放普攻第2段。\n \n实论数据获取规则\n【实论数据】上限5段。\n普攻第1段、普攻第2段、普攻第4段命中目标时，获得1段【实论数据】。\n普攻第3段命中目标时，获得2段【实论数据】。\n空中攻击命中目标时，获得1段【实论数据】。\n闪避反击命中目标时，获得1段【实论数据】。","descEn":"Flare Star Butterfly\nHitting a target with a Normal Attack generates a Collapsed Core, which transforms into a Flare Star Butterfly after 6s. Flare Star Butterflies automatically track and attack a target, dealing Spectro DMG. If there are already 5 Collapsed Cores, Shorekeeper's next Basic Attack hit will instantly convert a Collapsed Core into a Flare Star Butterfly.\n \nIllation\nWhen Shorekeeper has 5 segments of Empirical Data, casting Heavy Attack will consume all segments to pull in nearby targets, dealing Spectro DMG. Meanwhile, all generated Collapsed Cores will instantly transform into Flare Star Butterflies.\n \nTransmutation\nWhen Shorekeeper has 5 segments of Empirical Data, casting Mid-air Attack will consume all segments to deal Spectro DMG. Meanwhile, all generated Collapsed Cores will instantly transform into Flare Star Butterflies. Quickly press the Normal Attack Button afterward to perform Basic Attack Stage 2.\n \nEmpirical Data\nShorekeeper can hold up to 5 segments of Empirical Data.\n- Obtain 1 segment of Empirical Data when Basic Attack Stage 1, 2, or 4 hits a target.\n- Obtain 2 segments of Empirical Data when Basic Attack Stage 3 hits a target.\n- Obtain 1 segment of Empirical Data when Mid-air Attack hits a target.\n- Obtain 1 segment of Empirical Data when Dodge Counter hits a target.","params":[{"label":"耀星·蝶伤害","labelEn":"Flare Star Butterfly DMG","values":["18.76%","20.29%","21.83%","23.99%","25.52%","27.29%","29.75%","32.21%","34.67%","37.29%"]},{"label":"演绎伤害","labelEn":"Illation DMG","values":["9.54%*5","10.33%*5","11.11%*5","12.20%*5","12.99%*5","13.89%*5","15.14%*5","16.39%*5","17.64%*5","18.97%*5"]},{"label":"衍变伤害","labelEn":"Transmutation DMG","values":["37.20%","40.26%","43.31%","47.58%","50.63%","54.13%","59.02%","63.90%","68.78%","73.96%"]},{"label":"演绎耐力消耗","labelEn":"Illation STA Cost","values":["25","25","25","25","25","25","25","25","25","25"]},{"label":"衍变耐力消耗","label