:[2.0],"concerto":[2.0],"elementPowerType":5,"toughness":[0.4],"offTune":[0.105],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1505301990],"confidence":"high"},{"label":"治疗量","labelEn":"Healing","term":0,"count":1,"multiplier":[0.03,0.0325,0.035,0.0384,0.0409,0.0437,0.0476,0.0516,0.0555,0.0597],"flatAdd":[660.0,715.0,769.0,845.0,899.0,961.0,1047.0,1134.0,1221.0,1313.0],"damageId":1505600001,"type":"skill","typeId":4,"typeName":"共鸣技能","calc":"heal","element":"physical","elementId":0,"scaling":"hp","rateField":"RateLv","flat":[660,715,769,845,899,961,1047,1134,1221,1313],"energy":[0.0],"concerto":[0.0],"elementPowerType":0,"toughness":[0.0],"offTune":[0.0],"hardness":[0.0],"formulaType":0,"subType":[],"damageIds":[1505600001],"confidence":"high"}],"cooldown":16.0,"concertoGain":20.0,"confidence":"high","skillIcon":"assets/skills/1002502.webp?v=4dc24e6f1252"},{"id":1002503,"type":3,"typeName":"共鸣解放","typeNameEn":"Resonance Liberation","name":"终末回环","nameEn":"End Loop","maxLevel":10,"desc":"浅析星域\n展开浅析星域，持续为处于星域生效范围内的附近队伍中登场角色回复生命值，每3秒可触发1次。\n \n深潜星域\n浅析星域持续期间，当附近队伍中的角色使用变奏技能时，将进入深潜星域。深潜星域生效范围内附近队伍中所有角色暴击提升：守岸人自身每0.2%共鸣效率计算为0.01%暴击提升，上限12.5%。\n深潜星域继承浅析星域的所有效果。\n \n解限星域\n深潜星域持续期间，当附近队伍中的角色使用变奏技能时，将进入解限星域。解限星域生效范围内附近队伍中所有角色暴击伤害提升：守岸人自身每0.1%共鸣效率计算为0.01%暴击伤害提升，上限25%。\n解限星域继承浅析星域和深潜星域的所有效果。","descEn":"Outer Stellarealm\nGenerate the Outer Stellarealm to restore HP for all party members within its effective range continuously. This effect can be triggered once every 3s.\n \nInner Stellarealm\nWhen a party member uses Intro Skill within the Outer Stellarealm, it evolves into the Inner Stellarealm. Within the effective range of the Inner Stellarealm, for every 0.2% of Shorekeeper's Energy Regen, all party members gain a 0.01% increase of Crit. Rate, up to 12.5%. \nInner Stellarealm has all the effects of the Outer Stellarealm.\n \nSupernal Stellarealm\nWhen a party member uses Intro Skill within the Inner Stellarealm, it evolves into the Supernal Stellarealm. Within the effective range of the Supernal Stellarealm, for every 0.1% of Shorekeeper's Energy Regen, all party members gain a 0.01% increase of Crit. DMG, up to 25%. \nSupernal Stellarealm has all the effects of the Inner Stellarealm.","params":[{"label":"治疗量","labelEn":"Healing","values":["220+1.20%","239+1.30%","257+1.40%","282+1.54%","300+1.64%","321+1.75%","349+1.91%","378+2.07%","407+2.22%","438+2.39%"]},{"label":"星域持续时间","labelEn":"Stellarealm Duration","values":["30","30","30","30","30","30","30","30","30","30"]},{"label":"冷却时间","labelEn":"Cooldown","values":["25","25","25","25","25","25","25","25","25","25"]},{"label":"消耗共鸣能量","labelEn":"Resonance Cost","values":["175","175","175","175","175","175","175","175","175","175"]},{"label":"回复协奏能量","labelEn":"Concerto Regen","values":["20","20","20","20","20","20","20","20","20","20"]}],"hits":[{"label":"治疗量","labelEn":"Healing","term":0,"count":1,"multiplier":[0.012,0.013,0.014,0.0154,0.0164,0.0175,0.0191,0.0207,0.0222,0.0239],"flatAdd":[220.0,239.0,257.0,282.0,300.0,321.0,349.0,378.0,407.0,438.0],"damageId":1505600003,"type":"basic","typeId":0,"typeName":"普攻","calc":"heal","element":"physical","elementId":0,"scaling":"hp","rateField":"RateLv","flat":[220,239,257,282,300,321,349,378,407,438],"energy":[0.0],"concerto":[0.0],"elementPowerType":0,"toughness":[0.0],"offTune":[0.0],"hardness":[0.0],"formulaType":0,"subType":[],"damageIds":[1505600003],"confidence":"high"}],"cooldown":25.0,"energyCost":175.0,"concertoGain":20.0,"confidence":"high","skillIcon":"assets/skills/1002503.webp?v=029105098019"},{"id":1002504,"type":4,"typeName":"固有技能","typeNameEn":"Inherent Skill","name":"死生流溢","nameEn":"Life Entwined","maxLevel":1,"desc":"队伍中有守岸人自身以外的角色受到致死伤害时，此次伤害不会使该角色倒下并获得守岸人当前50%生命值，守岸人扣除等量生命值。守岸人最少保留1点生命值，该效果每10分钟可触发1次。","descEn":"When a Resonator other than Shorekeeper takes a fatal blow, they will not be knocked out and will instead be healed for 50% of Shorekeeper's HP while Shorekeeper loses the same amount of HP. Shorekeeper's HP will not go below 1 from this effect. This effect can be triggered once every 10 minutes.","params":[],"hits":[],"confidence":"high","skillIcon":"assets/skills/1002504.webp?v=b29762aaf839"},{"id":1002505,"type":4,"typeName":"固有技能","typeNameEn":"Inherent Skill","name":"自我引力","nameEn":"Self Gravitation","maxLevel":1,"desc":"队伍中登场角色处于星域生效范围内时，守岸人共鸣效率提升10%，若漂泊者处于同一编队中，漂泊者共鸣效率提升10%。","descEn":"When the on-field Resonator is within range of a Stellarealm, Shorekeeper's Energy Regen is increased by 10%, and Rover's Energy Regen is also increased by 10% if Rover is on the team.","params":[],"hits":[],"confidence":"high","skillIcon":"assets/skills/1002505.webp?v=96f95d2e8557"},{"id":1002506,"type":5,"typeName":"变奏技能","typeNameEn":"Intro Skill","name":"故此证明","nameEn":"Proof of Existence","maxLevel":10,"desc":"启迪\n守岸人出现，回复附近队伍中所有角色的生命值，并召唤5只黯星·蝶。黯星·蝶将自动追踪目标，造成衍射伤害，此次伤害为共鸣技能伤害。\n \n洞悉\n解限星域持续期间，守岸人的变奏技能启迪替换为变奏技能洞悉。施放时对应星域状态结束，回复附近队伍中所有角色的生命值，并攻击目标造成衍射伤害。此次伤害为共鸣解放伤害，并且必定暴击。同一个解限星域中仅可触发1次变奏技能洞悉。","descEn":"Enlightenment\nShorekeeper appears to restore HP for all nearby party members and summon 5 Dim Star Butterflies, which automatically track and attack a target, dealing Spectro DMG. This is considered Resonance Skill DMG.\n \nDiscernment\nWhen a Supernal Stellarealm is generated, Shorekeeper's first Intro Skill triggered in its duration will be replaced with Intro Skill Discernment.  Casting Discernment ends the current Stellarealm, restores HP for all nearby party members, and deals Spectro DMG to the targets. This attack is guaranteed to be a Critical Hit dealing Resonance Liberation DMG. The Intro Skill Discernment can only be triggered once each time a Supernal Stellarealm is generated.","params":[{"label":"启迪伤害","labelEn":"Enlightenment DMG","values":["22.79%*5","24.66%*5","26.53%*5","29.14%*5","31.01%*5","33.16%*5","36.15%*5","39.14%*5","42.13%*5","45.30%*5"]},{"label":"洞悉伤害","labelEn":"Discernment DMG","values":["9.88%*3","10.69%*3","11.50%*3","12.64%*3","13.45%*