y 1.2s. The effect lasts for 1.5s.","params":[{"label":"技能伤害","labelEn":"Skill DMG","values":["12.00%","12.99%","13.97%","15.35%","16.33%","17.47%","19.04%","20.61%","22.19%","23.86%"]},{"label":"雷之楔协同攻击伤害","labelEn":"Thunder Wedge Coordinated Attack DMG","values":["4.00%","4.33%","4.66%","5.12%","5.45%","5.83%","6.35%","6.87%","7.40%","7.96%"]},{"label":"雷之楔引爆伤害","labelEn":"Thunder Wedge Detonation Damage","values":["30.00%","32.46%","34.92%","38.37%","40.83%","43.66%","47.59%","51.53%","55.47%","59.65%"]},{"label":"万壑雷伤害","labelEn":"Rumbling Spark Damage","values":["54.60%","59.07%","63.55%","69.82%","74.29%","79.44%","86.60%","93.76%","100.93%","108.54%"]},{"label":"雷之楔持续时间","labelEn":"Thunder Wedge Duration","values":["12","12","12","12","12","12","12","12","12","12"]},{"label":"冷却时间","labelEn":"Cooldown","values":["3","3","3","3","3","3","3","3","3","3"]},{"label":"拳震凌武回复协奏能量","labelEn":"Leihuang Master Concerto Regen","values":["3","3","3","3","3","3","3","3","3","3"]},{"label":"万壑雷回复协奏能量","labelEn":"Rumbling Spark Concerto Regen","values":["25","25","25","25","25","25","25","25","25","25"]}],"hits":[{"label":"技能伤害","labelEn":"Skill DMG","term":0,"count":1,"multiplier":[0.12,0.1299,0.1397,0.1535,0.1633,0.1747,0.1904,0.2061,0.2219,0.2386],"damageId":1303200001,"type":"skill","typeId":4,"typeName":"共鸣技能","calc":"damage","element":"electro","elementId":3,"scaling":"def","rateField":"RateLv","flat":null,"energy":[3.0],"concerto":[0.0],"elementPowerType":3,"toughness":[2.0],"offTune":[0.584],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1303200001],"confidence":"high"},{"label":"雷之楔协同攻击伤害","labelEn":"Thunder Wedge Coordinated Attack DMG","term":0,"count":1,"multiplier":[0.04,0.0433,0.0466,0.0512,0.0545,0.0583,0.0635,0.0687,0.074,0.0796],"damageId":1303904003,"type":"skill","typeId":4,"typeName":"共鸣技能","calc":"damage","element":"electro","elementId":3,"scaling":"def","rateField":"RateLv","flat":null,"energy":[0.0],"concerto":[0.0],"elementPowerType":0,"