tro Skill Pero, Help restores 100 Imagination.","params":[{"label":"第一段伤害","labelEn":"Stage 1 DMG","values":["162.00%","175.29%","188.57%","207.17%","220.45%","235.73%","256.99%","278.24%","299.49%","322.08%"]},{"label":"第二段伤害","labelEn":"Stage 2 DMG","values":["171.00%","185.03%","199.05%","218.68%","232.70%","248.83%","271.26%","293.70%","316.13%","339.97%"]},{"label":"第三段伤害","labelEn":"Stage 3 DMG","values":["180.00%","194.76%","209.52%","230.19%","244.95%","261.92%","285.54%","309.15%","332.77%","357.86%"]},{"label":"第一段回复协奏能量","labelEn":"Stage 1 Concerto Regen","values":["10","10","10","10","10","10","10","10","10","10"]},{"label":"第二段回复协奏能量","labelEn":"Stage 2 Concerto Regen","values":["16","16","16","16","16","16","16","16","16","16"]},{"label":"第三段回复协奏能量","labelEn":"Stage 3 Concerto Regen","values":["25","25","25","25","25","25","25","25","25","25"]}],"hits":[{"label":"第一段伤害","labelEn":"Stage 1 DMG","term":0,"count":1,"multiplier":[1.62,1.7529,1.8857,2.0717,2.2045,2.3573,2.5699,2.7824,2.9949,3.2208],"damageId":1606012001,"type":"heavy","typeId":1,"typeName":"重击","calc":"damage","element":"havoc","elementId":6,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[8.0],"concerto":[0.0],"elementPowerType":6,"toughness":[1.0],"offTune":[0.72],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1606012001],"confidence":"high"},{"label":"第二段伤害","labelEn":"Stage 2 DMG","term":0,"count":1,"multiplier":[1.71,1.8503,1.9905,2.1868,2.327,2.4883,2.7126,2.937,3.1613,3.3997],"damageId":1606012002,"type":"heavy","typeId":1,"typeName":"重击","calc":"damage","element":"havoc","elementId":6,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[8.0],"concerto":[0.0],"elementPowerType":6,"toughness":[1.0],"offTune":[0.76],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1606012002],"confidence":"high"},{"label":"第三段伤害","labelEn":"Stage 3 DMG","term":0,"count":1,"multiplier":[1.8,1.9476,2.0952,2.3019,2.4495,2.6192,2.8554,3.0915,3.3277,3.5786],"damageId":1