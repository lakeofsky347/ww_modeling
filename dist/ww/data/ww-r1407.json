ll,"energy":[2.4],"concerto":[0.0],"elementPowerType":4,"toughness":[0.5],"offTune":[0.125],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1407101010,1407102010],"variants":[{"damageId":1407102010,"type":"skill","typeId":4,"element":"aero","scaling":"atk","flat":null,"energy":[2.4],"concerto":[0.0],"toughness":[0.5],"offTune":[0.125]}],"confidence":"high"}],"cooldown":10.0,"concertoGain":15.0,"confidence":"high","skillIcon":"assets/skills/1003402.webp?v=70e1954c6e72"},{"id":1003403,"type":3,"typeName":"共鸣解放","typeNameEn":"Resonance Liberation","name":"歌者的三重华彩","nameEn":"Singer's Triple Cadenza","maxLevel":10,"desc":"夏空与合奏音影共同演绎即兴的交响诗，对周围目标造成一次气动伤害并进入演绎状态。\n\n 演绎状态\n演绎状态下，当音波进入判定圈范围时，短按绿色或黄色按钮可生成对应颜色的交响诗·主音，并回复一定协奏能量。\n·演绎状态持续期间，切换至其他角色不会结束演绎状态并可自动生成交响诗·主音，自动生成的主音的颜色由切换角色前最后一个生成的主音的颜色决定。在未通过按钮交互生成交响诗·主音时直接切换至其他角色，默认自动生成绿色的主音。\n·演绎状态持续期间，夏空免疫受击，受到的伤害降低50%。\n·演绎状态持续期间，再次短按共鸣解放，或在切换至其他角色后再切换至夏空，可提前结束演绎状态。\n·演绎状态下的合奏音影可触发音律独奏的气动伤害加成提升效果。\n\n 交响诗·主音\n主音为绿色时：对周围的目标造成气动伤害，并为命中的目标添加一层【风蚀效应】。\n主音为黄色时：对周围的目标造成气动伤害，并为命中的目标添加一层【光噪效应】。","descEn":"Ciaccona and Ensemble Sylphs perform an Improvised Symphonic Poem together, dealing Aero DMG once to the nearby targets and entering Recital.\n\nRecital\nWhen in Recital, sound waves will periodically radiate around Ciaccona. When the sound wave overlaps with the circle indicator, {Cus:Ipt,Touch=tap PC=press Gamepad=press} the green or yellow buttons to generate Symphonic Poem: Tonic of the corresponding color and recover a certain amount of Concerto Energy.\nDuring Recital:\n- Switching to another Resonator doesn't end Recital, but automatically generates a Symphonic Poem: Tonic matching the color of the last generated Tonic before switching. A green Symphonic Poem: Tonic is generated by default if no interaction input is given before switching to another Resonator.\n- Ciaccona is immune to interruptions and takes 50% less DMG.\n- Exit Recital by {Cus:Ipt,Touch=tapping PC=pressing Gamepad=pressing} Resonance Liberation again or switching Ciaccona back onto the field.\n- Ensemble Sylphs can now directly grant Aero DMG Bonus provided by Solo Concert.\n\nSymphonic Poem: Tonic\nGreen Tonic: Deal Aero DMG to nearby targets and inflict a stack of Aero Erosion on targets hit.\nYellow Tonic: Deal Aero DMG to nearby targets and inflict a stack of Spectro Frazzle on targets hit.","params":[{"label":"即兴的交响诗伤害","labelEn":"Improvised Symphonic Poem Skill DMG","values":["553.50%","598.89%","644.28%","707.82%","753.21%","805.40%","878.02%","950.64%","1023.26%","1100.42%"]},{"label":"交响诗·主音伤害","labelEn":"Symphonic Poem: Tonic DMG","values":["3.08%*20","3.33%*20","3.58%*20","3.94%*20","4.19%*20","4.48%*20","4.88%*20","5.29%*20","5.69%*20","6.12%*20"]},{"label":"冷却时间","labelEn":"Cooldown","values":["20","20","20","20","20","20","20","20","20","20"]},{"label":"消耗共鸣能量","labelEn":"Resonance Cost","values":["125","125","125","125","125","125","125","125","125","125"]},{"label":"回复协奏能量","labelEn":"Concerto Regen","values":["20","20","20","20","20","20","20","20","20","20"]},{"label":"交互成功时回复协奏能量","labelEn":"Successful Interaction Concerto Regen","values":["10","10","10","10","10","10","10","10","10","10"]}],"hits":[{"label":"即兴的交响诗伤害","labelEn":"Improvised Symphonic Poem Skill DMG","term":0,"count":1,"multiplier":[5.535,5.9889,6.4428,7.0782,7.5321,8.054,8.7802,9.5064,10.2326,11.0042],"damageId":1407200070,"type":"liberation","typeId":2,"typeName":"共鸣解放","calc":"damage","element":"aero","elementId":4,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[0.0],"concerto":[0.0],"elementPowerType":4,"toughness":[4.05],"offTune":[4.8],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1407200070],"confidence":"high"},{"label":"交响诗·主音伤害","labelEn":"Symphonic Poem: Tonic DMG","term":0,"count":20,"multiplier":[0.0308,0.0333,0.0358,0.0394,0.0419,0.0448,0.0488,0.0529,0.0569,0.0612],"damageId":1407200010,"type":"liberation","typeId":2,"typeName":"共鸣解放","calc":"damage","element":"aero","elementId":4,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[0.0],"concerto":[0.0],"elementPowerType":4,"toughness":[0.0225],"offTune":[0.2182],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1407200010],"confidence":"high"}],"cooldown":20.0,"energyCost":125.0,"concertoGain":10.0,"confidence":"high","skillIcon":"assets/skills/1003403.webp?v=a5c3c36c8cd9"},{"id":1003404,"type":4,"typeName":"固有技能","typeNameEn":"Inherent Skill","name":"幕间伴奏","nameEn":"Interlude Tune","maxLevel":1,"desc":"夏空施放共鸣解放歌者的三重华彩时，获得一个自身生命上限100%的护盾，持续4秒，该护盾在切换至其他角色时不会继承。","descEn":"Casting Resonance Liberation Singer's Triple Cadenza grants Ciaccona a Shield equal to 100% of her Max HP for 4s. Switching out Ciaccona removes the Shield.","params":[],"hits":[],"confidence":"high","skillIcon":"assets/skills/1003404.webp?v=a71cb6ad3043"},{"id":1003405,"type":4,"typeName":"固有技能","typeNameEn":"Inherent Skill","name":"黎那汐塔之风","nameEn":"Winds of Rinascita","maxLevel":1,"desc":"重击·四拍重奏造成的伤害提升30%。","descEn":"Increase Heavy Attack - Quadruple Downbeat's DMG by 30%.","params":[],"hits":[],"confidence":"high","skillIcon":"assets/skills/1003405.webp?v=ccccb4fa8903"},{"id":1003406,"type":5,"typeName":"变奏技能","typeNameEn":"Intro Skill","name":"携风吟游","nameEn":"Roaming with the Wind","maxLevel":10,"desc":"攻击目标，造成气动伤害，为目标附加一层【风蚀效应】。\n施放后一定时间内短按普攻，将会施放第3段普攻。","descEn":"Attack the target to deal Aero DMG and inflict a stack of Aero Erosion.\nFollow up with Basic Attack in time to cast Basic Attack Stage 3.","params":[{"label":"技能伤害","labelEn":"Skill DMG","values":["95.12%","102.92%","110.72%","121.64%","129.44%","138.41%","150.89%","163.37%","175.85%","189.11%"]},{"label":"回复协奏能量","labelEn":"Concerto Regen","values":["10","10","10","10","10","10","10","10","10","10"]}],"hits":[{"label":"技能伤害","labelEn":"Skill DMG","term":0,"count":1,"multiplier":[0.9512,1.0292,1.1072,1.2164,1.2944,1.3841,1.5089,1.6337,1.7585,1.8911],"damageId":1407601001,"type":"intro","typeId":3,"typeName":"变奏技能","calc":"damage","element":"aero","e