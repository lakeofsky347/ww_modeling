":"atk","flat":null,"energy":[3.0],"concerto":[3.5],"toughness":[0.7],"offTune":[0.56]}],"confidence":"high"},{"label":"月弓·闪避反击伤害","labelEn":"Moonbow - Dodge Counter DMG","term":0,"count":3,"multiplier":[0.52,0.5627,0.6053,0.665,0.7077,0.7567,0.8249,0.8931,0.9614,1.0339],"damageId":1410510021,"type":"liberation","typeId":2,"typeName":"共鸣解放","calc":"damage","element":"aero","elementId":4,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[0.59],"concerto":[1.17],"elementPowerType":4,"toughness":[0.5],"offTune":[0.1867],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1410510021],"confidence":"high"}],"confidence":"high","skillIcon":"assets/skills/1003801.webp?v=f0e314cf8527"},{"id":1003802,"type":2,"typeName":"共鸣技能","typeNameEn":"Resonance Skill","name":"先觉赋格","nameEn":"Foresight Fugue","maxLevel":10,"desc":"原初的律动\n尤诺向前突进，造成气动伤害。\n\n告终的喧响\n尤诺不处于月相流转状态时，施放月环·普攻第3段、变奏技能或原初的律动时，共鸣技能替换为告终的喧响，持续5秒。\n施放告终的喧响时，造成多段气动伤害，并进入月相流转状态。 \n\n未终的喧响\n尤诺处于月相流转·弦月状态时，共鸣技能替换为未终的喧响。\n施放未终的喧响时，造成多段气动伤害。\n告终的喧响与未终的喧响共用同一个冷却时间。\n\n越限的弦引\n尤诺处于月相流转·新月状态时，共鸣技能替换为越限的弦引，初始拥有2次可施放次数。\n施放越限的弦引时，尤诺进行一次位移，并造成气动伤害，此次伤害为共鸣解放伤害。\n-技能位移期间可通过移动输入延长位移距离。当尤诺处于受击或被击飞状态中，施放越限的弦引将脱离受击状态或被击飞状态。\n可在空中施放。","descEn":"Pulse of Origins\nDash forward, dealing Aero DMG.\n\nClosing Refrain\nWhen not in Lunar Cycle, casting Moonring - Basic Attack Stage 3, Intro Skill, or Pulse of Origins replaces Iuno's Resonance Skill with Closing Refrain for 5s.\nCasting Closing Refrain unleashes a flurry of strikes, dealing Aero DMG, and activates Lunar Cycle.\n\nUnfinished Refrain\nWhen in Lunar Cycle - Half Moon, Iuno's Resonance Skill is replaced with Unfinished Refrain.\nCasting Unfinished Refrain unleashes a flurry of strikes, dealing Aero DMG.\nUnfinished Refrain shares the same Cooldown as Closing Refrain.\n\nArc Beyond the Edge\nWhen Iuno is in Lunar Cycle - New Moon, her Resonance Skill is replaced with Arc Beyond the Edge, which has 2 initial charges.\nCasting Arc Beyond the Edge causes Iuno to shift position and deal Aero DMG, considered as Resonance Liberation DMG.\n- Directional input can be used to extend the travel distance. If Iuno is hit or launched into mid-air, casting Arc Beyond the Edge immediately makes her recover from the attack.\nCan be cast in mid-air.","params":[{"label":"原初的律动伤害","labelEn":"Pulse of Origins DMG","values":["9.38%*7+65.65%","10.15%*7+71.04%","10.92%*7+76.42%","12.00%*7+83.96%","12.77%*7+89.34%","13.65%*7+95.53%","14.88%*7+104.15%","16.11%*7+112.76%","17.34%*7+121.37%","18.65%*7+130.52%"]},{"label":"原初的律动冷却时间","labelEn":"Pulse of Origins Cooldown","values":["6","6","6","6","6","6","6","6","6","6"]},{"label":"原初的律动回复协奏能量","labelEn":"Pulse of Origins Concerto Regen","values":["6","6","6","6","6","6","6","6","6","6"]},{"label":"告终的喧响伤害","labelEn":"Closing Refrain DMG","values":["70.79%*2+72.93%","76.59%*2+78.92%","82.40%*2+84.90%","90.52%*2+93.27%","96.33%*2+99.25%","103.00%*2+106.13%","112.29%*2+115.69%","121.58%*2+125.26%","130.87%*2+134.83%","140.73%*2+145.00%"]},{"label":"告终的喧响回复协奏能量","labelEn":"Closing Refrain Concerto Regen","values":["8","8","8","8","8","8","8","8","8","8"]},{"label":"未终的喧响伤害","labelEn":"Unfinished Refrain DMG","values":["70.79%*2+72.93%","76.59%*2+78.92%","82.40%*2+84.90%","90.52%*2+93.27%","96.33%*2+99.25%","103.00%*2+106.13%","112.29%*2+115.69%","121.58%*2+125.26%","130.87%*2+134.83%","140.73%*2+145.00%"]},{"label":"告终与未终的喧响冷却时间","labelEn":"Closing/Unfinished Refrain Cooldown","values":["8","8","8","8","8","8","8","8","8","8"]},{"label":"未终的喧响回复协奏能量","labelEn":"Unfinished Refrain Concerto Regen","values":["8","8","8","8","8","8","8","8","8","8"]},{"label":"越限的弦引伤害","labelEn":"Arc Beyond the Edge DMG","values":["110.55%*2","119.62%*2","128.69%*2","141.38%*2","150.44%*2","160.87%*2","175.37%*2","189.87%*2","204.38%*2","219.79%*2"]},{"label":"越限的弦引冷却时间","labelEn":"Arc Beyond the Edge Cooldown","values":["10","10","10","10","10","10","10","10","10","10"]},{"label":"越限的弦引回复协奏能量","labelEn":"Arc Beyond the Edge Concer