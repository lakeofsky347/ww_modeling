on","typeId":2,"element":"aero","scaling":"atk","flat":null,"energy":[4.68],"concerto":[0.0],"toughness":[1.0],"offTune":[0.536]}],"confidence":"high"}],"concertoGain":8.0,"confidence":"high","skillIcon":"assets/skills/1003802.webp?v=284980017e19"},{"id":1003803,"type":3,"typeName":"共鸣解放","typeNameEn":"Resonance Liberation","name":"溺失月海","nameEn":"Beneath Lunar Tides","maxLevel":10,"desc":"造成气动伤害，并进入月相流转状态。\n可在空中施放。","descEn":"Deal Aero DMG and activate the Lunar Cycle state.\nCan be cast in mid-air.","params":[{"label":"技能伤害","labelEn":"Skill DMG","values":["550.00%","595.10%","640.20%","703.34%","748.44%","800.31%","872.47%","944.63%","1016.79%","1093.46%"]},{"label":"冷却时间","labelEn":"Cooldown","values":["25","25","25","25","25","25","25","25","25","25"]},{"label":"消耗共鸣能量","labelEn":"Resonance Cost","values":["125","125","125","125","125","125","125","125","125","125"]},{"label":"回复协奏能量","labelEn":"Concerto Regen","values":["20","20","20","20","20","20","20","20","20","20"]}],"hits":[{"label":"技能伤害","labelEn":"Skill DMG","term":0,"count":1,"multiplier":[5.5,5.951,6.402,7.0334,7.4844,8.0031,8.7247,9.4463,10.1679,10.9346],"damageId":1410300001,"type":"liberation","typeId":2,"typeName":"共鸣解放","calc":"damage","element":"aero","elementId":4,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[0.0],"concerto":[0.0],"elementPowerType":4,"toughness":[4.0],"offTune":[9.6],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1410300001],"confidence":"high"}],"cooldown":25.0,"energyCost":125.0,"concertoGain":20.0,"confidence":"high","skillIcon":"assets/skills/1003803.webp?v=d422d55ccb50"},{"id":1003804,"type":4,"typeName":"固有技能","typeNameEn":"Inherent Skill","name":"盈昇","nameEn":"Waxing Ascent","maxLevel":1,"desc":"尤诺每次施放普攻、重击、闪避反击、共鸣技能、共鸣解放、变奏技能时，可获得1个基于自身攻击32%的护盾，持续15秒。该护盾在切换至其他角色时不会继承。","descEn":"Every time Iuno casts Basic Attack, Heavy Attack, Dodge Counter, Resonance Skill, Resonance Liberation, or Intro Skill, she gains 1 Shield equal to 32% of her ATK for 15s. This Shield will not be passed on to the incoming Resonator.","params":[],"hits":[],"confidence":"high","skillIcon":"assets/skills/1003804.webp?v=6d3f65015c24"},{"id":1003805,"type":4,"typeName":"固有技能","typeNameEn":"Inherent Skill","name":"新衍","nameEn":"Derivation","maxLevel":1,"desc":"尤诺施放变奏技能或共鸣解放时，自身可直接获得5层苍白死光的祝颂。","descEn":"When Iuno casts Intro Skill or Resonance Liberation, she immediately gains 5 stacks of Blessing of the Wan Light.","params":[],"hits":[],"confidence":"high","skillIcon":"assets/skills/1003805.webp?v=2e4e6440ee4d"},{"id":1003806,"type":5,"typeName":"变奏技能","typeNameEn":"Intro Skill","name":"照我以显","nameEn":"Illuminated Manifestation","maxLevel":10,"desc":"造成气动伤害。","descEn":"Deal Aero DMG.","params":[{"label":"技能伤害","labelEn":"Skill DMG","values":["8.00%*7+24.00%","8.66%*7+25.97%","9.32%*7+27.94%","10.24%*7+30.70%","10.89%*7+32.66%","11.65%*7+34.93%","12.70%*7+38.08%","13.74%*7+41.22%","14.79%*7+44.37%","15.91%*7+47.72%"]},{"label":"回复协奏能量","labelEn":"Concerto Regen","values":["10","10","10","10","10","10","10","10","10","10"]}],"hits":[{"label":"技能伤害","labelEn":"Skill DMG","term":0,"count":7,"multiplier":[0.08,0.0866,0.0932,0.1024,0.1089,0.1165,0.127,0.1374,0.1479,0.1591],"damageId":1410600001,"type":"intro","typeId":3,"typeName":"变奏技能","calc":"damage","element":"aero","elementId":4,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[1.0],"concerto":[0.0],"elementPowerType":4,"toughness":[0.15],"offTune":[0.104],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1410600001],"confidence":"high"},{"label":"技能伤害","labelEn":"Skill DMG","term":1,"count":1,"multiplier":[0.24,0.2597,0.2794,0.307,0.3266,0.3493,0.3808,0.4122,0.4437,0.4772],"damageId":1410600003,"type":"intro","typeId":3,"typeName":"变奏技能","calc":"damage","element":"aero","elementId":4,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[3.0],"concerto":[0.0],"elementPowerType":4,"toughness":[0.45],"offTune":[0.312],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1410600003],"confidence":"high"}],"concertoGain":10.0,"confidence":"high","skillIcon":"assets/skills/1003806.webp?v=19a662c90897"},{"id":1003807,"type":6,"typeName":"共鸣回路","typeNameEn":"Forte Circuit","name":"于盈亏间涨落","nameEn":"Ebb and Flow","maxLevel":10,"desc":"月相流转\n尤诺可以通过施放共鸣技能·告终的喧响或共鸣解放进入月相流转状态。\n月相流转分为弦月和新月两种状态，初始默认进入弦月状态，尤诺可以通过施放重击·流变进行两种状态间的切换。\n处于月相流转状态下：尤诺的跳跃替换为重击·流变；尤诺在空中时无法进行耐力回复；\n移动时，尤诺会进入漫溯巡游状态，以特殊表现进行移动，在空中时会持续消耗耐力。\n当触发特定场景交互、探索工具或长按跳跃键时，将退出月相流转状态。\n\n月相流转·弦月\n尤诺使用月环攻击，命中目标时可恢复【灵性】。\n尤诺可施放重击·流变·月弓，造成气动伤害，此次伤害为共鸣解放伤害，进入月相流转·新月状态。\n重击·流变·月弓可在空中施放。\n\n月相流转·新月\n尤诺使用月弓攻击，施放月弓·普攻、共鸣技能·越限的弦引、月弓·闪避反击时可消耗【灵性】，提升该次技能的伤害倍率，回复额外的协奏能量，并为附近队伍中的角色回复生命值。\n尤诺可施放重击·流变·月环，造成气动伤害，此次伤害为共鸣解放伤害，进入月相流转·弦月状态。\n重击·流变·月环可在空中施放。\n\n重击·至臻的完满\n尤诺协奏能量充满时，重击替换为至臻的完满。\n施放至臻的完满时，尤诺结束自身的月相流转状态，为附近队伍中的角色回复生命值；\n对周围目标造成气动伤害，此次伤害为共鸣解放伤害；\n以自身为中心展开满月领域，该效果25秒最多可触发一次。\n可在空中施放。\n\n满月领域\n处于领域中的角色，周期性获得治疗和耐力回复。\n处于领域中的登场角色获得护盾时，可获得一层苍白死光的祝颂，该效果每0.5秒可触发一次。\n\n苍白死光的祝颂\n角色全伤害加深4%，持续10秒，可叠加10层，重复添加时刷新持续时间。若切换至其他角色则该效果提前结束。\n\n灵性\n灵性上限100点。\n尤诺施放变奏技能时，可获得40点【灵性】。\n尤诺施放共鸣解放时，可获得60点【灵性】。\n尤诺施放告终的喧响或未终的喧响时，可获得25点【灵性】。\n尤诺处于月相流转状态时，月环·普攻、月环·闪避反击、空中攻击命中目标时，可获得【灵性】。","descEn":"Lunar Cycle\nIuno can activate Lunar Cycle by casting Resonance Skill - Closing Refrain or Resonance Liberation.\nLunar Cycle has two states: Half Moon and New Moon. By default, Iuno enters the Half Moon state when activating Lunar Cycle and can switch between the two states by casting Heavy Attack - Flux.\nWhen in Lunar Cycle:\n- Iuno's Jump is replaced with Heavy Attack - Flux. STA won't recover when Iuno is in mid-air. \n- Iuno's movement becomes Meandering, which consumes STA continuously in mid-air to move in a unique manner.\n- Performing environmental interactions, using Utilities, or holding Jump will end Lunar Cycle.\n\nLunar Cycle - Half Moon\nIuno attacks using the Moonring, restoring Sentience on hit.\nShe can use Heavy Attack - Flux: Moonbow to deal Aero DMG (considered as Resonance Liberation DMG) and switch to Lunar Cycle - New Moon.\nHeavy Attack - Flux: Moonbow can be cast in mid-air.\n\nLunar Cycle - New Moon\nIuno attacks using the Moonbow. While in this state, casting Moonbow - Basic Attack, Resonance Skill - Arc Beyond the Edge, or Moonbow - Dodge Counter consumes Sentience to increase the skill's DMG Multiplier, restore additional Concerto Energy, and heal nearby Resonators in the team.\nIuno can use Heavy Attack - Flux: Moonring to deal Aero DMG (considered as Resonance Liberation DMG) and switch to Lunar Cycle - Half Moon.\nHeavy Attack - Flux: Moonring can be cast in mid-air.\n\nHeavy Attack - Absolute Fullness\nWhen Iuno's Concerto Energy is full, her Heavy Attack is replaced with Absolute Fullness.\nCasting Absolute Fullness ends Lunar Cycle, provides healing for nearby Resonators in the team, deals Aero DMG to nearby targets (considered as Resonance Liberation DMG), and conjures a Full Moon domain at her location. This effect can be triggered once every 25s.\nCan be cast in mid-air.\n\nFull Moon Domain\nResonators inside the domain periodically restore  HP and STA.\nGaining a Shield inside the domain grants 1 stack of Blessing of the Wan Light. This effect can be triggered once every 0.5s.\n\nBlessing of the Wan Light\nThe receiving Resonator gains 4% all DMG Amplification for 10s, stacking up to 10 times. Gaining new stacks resets the duration. This effect ends early if the receiving Resonator is switched off the field.\n\nSentience\nIuno can hold up to 100 points of Sentience.\nCasting Intro Skill restores 40 points of Sentience.\nCasting Resonance Liberation restores 60 points of Sentience.\nCasting Closing Refrain or Unfinished Refrain restores 25 points of Sentience.\nWhen Iuno is in Lunar Cycle, Moonring - Basic Attack, Moonring - Dodge Counter, and Mid-air Attack restore Sentience on hit.","params":[{"label":"月相流转持续时间","labelEn":"Lunar Cycle Duration","values":["15","15","15","15","15","15","15","15","15","15"]},{"label":"流变·月弓伤害","labelEn":"F