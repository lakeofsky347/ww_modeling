ate":[12.9052,13.9635,15.0217,16.5032,17.5614,18.7784,20.4716,22.1647,23.8579,25.6569],"rateField":"RateLv","flat":null,"energy":[0.0],"concerto":[0.0],"elementPowerType":5,"toughness":[2.8],"offTune":[5.88],"hardness":[1.0],"formulaType":0,"subType":[],"confidence":"low","lowReason":"damage row not referenced by any description multiplier (conditional/variant hit or non-damage effect)"}],"confidence":"high","skillIcon":"assets/skills/1002003.webp?v=1dac4e464a82"},{"id":1002004,"type":4,"typeName":"固有技能","typeNameEn":"Inherent Skill","name":"沐光","nameEn":"Radiant Surge","maxLevel":1,"desc":"今汐的衍射伤害加成提升20%。","descEn":"Jinhsi gains 20% Spectro DMG Bonus.","params":[],"hits":[],"confidence":"high","skillIcon":"assets/skills/1002004.webp?v=d97e5156b536"},{"id":1002005,"type":4,"typeName":"固有技能","typeNameEn":"Inherent Skill","name":"凝神","nameEn":"Converged Flash","maxLevel":1,"desc":"变奏技能蟠龙清辉伤害倍率提升50%。","descEn":"DMG Multiplier of Intro Skill Loong's Halo is increased by 50%.","params":[],"hits":[],"confidence":"high","skillIcon":"assets/skills/1002005.webp?v=c8f49a82d36e"},{"id":1002006,"type":5,"typeName":"变奏技能","typeNameEn":"Intro Skill","name":"蟠龙清辉","nameEn":"Loong's Halo","maxLevel":10,"desc":"攻击目标，造成衍射伤害。","descEn":"Attack the target, dealing Spectro DMG.","params":[{"label":"技能伤害","labelEn":"Skill DMG","values":["80.00%","86.56%","93.12%","102.31%","108.87%","116.41%","126.91%","137.40%","147.90%","159.05%"]},{"label":"回复协奏能量","labelEn":"Concerto Regen","values":["10","10","10","10","10","10","10","10","10","10"]}],"hits":[{"label":"技能伤害","labelEn":"Skill DMG","term":0,"count":1,"multiplier":[0.8,0.8656,0.9312,1.0231,1.0887,1.1641,1.2691,1.374,1.479,1.5905],"damageId":1304402001,"type":"intro","typeId":3,"typeName":"变奏技能","calc":"damage","element":"spectro","elementId":5,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[10.0],"concerto":[0.0],"elementPowerType":5,"toughness":[1.0],"offTune":[0.8],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1304402001],"confidence":"high"}],"concertoGain":10.0,"unlinkedDamage":[{"damageId":1304402002,"type":"intro","typeId":3,"typeName":"变奏技能","calc":"damage","element":"spectro","elementId":5,"scaling":"atk","rate":[1.2,1.2984,1.3968,1.5346,1.633,1.7462,1.9036,2.061,2.2185,2.3858],"rateField":"RateLv","flat":null,"energy":[10.0],"concerto":[0.0],"elementPowerType":5,"toughness":[1.0],"offTune":[0.8],"hardness":[1.0],"formulaType":0,"subType":[],"confidence":"low","lowReason":"damage row not referenced by any description multiplier (conditional/variant hit or non-damage effect)"}],"confidence":"high","skillIcon":"assets/skills/1002006.webp?v=7acf0683ca00"},{"id":1002007,"type":6,"typeName":"共鸣回路","typeNameEn":"Forte Circuit","name":"万物一心","nameEn":"Luminal Synthesis","maxLevel":10,"desc":"乘岁凌霄\n乘岁凌霄状态持续期间：\n·普攻替换为普攻凌霄·普攻，进行最多连续4段攻击，造成衍射伤害，此次伤害为共鸣技能伤害，此外，该连击段数不会被重置。\n可以在空中施放。\n·共鸣技能替换为共鸣技能逐天取月，造成衍射伤害。\n可以在空中施放。\n·处于空中时，重击替换为重击凌霄·重击，消耗耐力攻击目标，造成衍射伤害。\n·处于空中时，闪避替换为凌霄·闪避，可以消耗耐力进行多次闪避。\n·闪避反击，替换为闪避反击凌霄·闪避反击，造成衍射伤害。\n可以在空中施放。\n \n共鸣技能·惊龙破空\n施放普攻凌霄·普攻第4段后，将立刻结束乘岁凌霄状态，并获得效果游龙廻光。\n可以在空中施放。\n游龙廻光效果持续期间：\n·处于空中时，普攻替换为重击凌霄·重击，消耗耐力攻击目标，造成衍射伤害。\n·共鸣技能替换为共鸣技能惊龙破空，形成熠日攻击目标，并在短暂时间后引爆炳星。施放时可以消耗今汐至多50点【韶光】，造成衍射伤害，每消耗1点【韶光】，使本次共鸣技能惊龙破空的炳星的伤害倍率增加。\n可以在空中施放。\n·施放共鸣技能惊龙破空后，今汐可获得同奏，每25秒内只能获得一次。\n \n同奏\n今汐拥有同奏时，今汐切换其他角色时，登场角色将施放自身变奏技能，今汐则施放自身延奏技能，并移除今汐身上的同奏效果。今汐协奏能量达到最大值，并且拥有同奏效果时，只消耗同奏效果。\n \n韶光的获取规则\n【韶光】上限50点。\n当今汐处于队伍中时，附近队伍中所有角色获得效果韶华共济。\n韶华共济包含两个独立效果：\n造成属性伤害时，为今汐提供1点【韶光】，同类属性伤害每3秒可触发1次。\n协同攻击造成伤害时，为今汐提供2点【韶光】，同类属性伤害每3秒可触发1次。","descEn":"Incarnation\nWhile in Incarnation:\n- Alternative Basic Attack \"Incarnation - Basic Attack\" becomes available. Perform up to 4 consecutive strikes, dealing Spectro DMG considered as Resonance Skill DMG. The basic attack cycle of this will not be reset. Can be cast in mid-air.\n- Alternative Resonance Skill \"Crescent Divinity\" becomes available. Deal Spectro DMG. Can be cast in mid-air.\n- Alternative Heavy Attack \"Incarnation - Heavy Attack\" becomes available. Attack the target in mid-air at the cost of Stamina, dealing Spectro DMG.\n- Alternative Dodge \"Incarnation - Dodge\" is available while in mid-air. Can be cast multiple times at the cost of Stamina.\n- Alternative Dodge Counter \"Incarnation - Dodge Counter\" becomes available. Deal Spectro DMG.\nCan be cast in mid-air.\n\nResonance Skill - Illuminous Epiphany\nAfter Stage 4 of Incarnation - Basic Attack, Incarnation terminates and Jinhsi gains Ordination Glow. \nCan be cast in mid-air.\nWhile Ordination Glow lasts:\n- Basic Attack is replaced with Heavy Attack \"Incarnation - Heavy Attack\". Attack the target in mid-air at the cost of Stamina, dealing Spectro DMG.\n- Resonance Skill is replaced with Resonance Skill \"Illuminous Epiphany\". Send out Solar Flare that detonates as Stella Glamor, dealing Spectro DMG after a short delay. Consume up to 50 Incandescence, with each point of Incandescence granting bonus DMG Multiplier percentage to Stella Glamor.\nCan be cast in mid-air.\n- After casting Resonance Skill Illuminous Epiphany, Jinhsi gains Unison. This can be triggered once every 25s.\n\nUnison\nWhile Jinhsi has Unison, switching to other Resonators will remove Jinhsi's Unison to trigger Jinhsi's Outro Skill and the incoming Resonator's Intro Skill. Unison will be consumed in priority in place of Concerto Energy when Concerto Energy is full.\n\nIncandescence\nJinhsi can hold up to 50 Incandescence.\nWhen Jinhsi is in the party, all nearby Resonators in the party gain Eras in Unity.\nEras in Unity provides 2 independent effects:\nJinhsi gains 1 Incandescence anytime Resonators in the party inflict Attribute DMG. This effect may be triggered by damage of the same Attribute for up to 1 time(s) every 3s. Additionally, Jinhsi gains 2 Incandescence when Resonators in the party damage the enemy with Coordinated Attacks. This effect may be triggered by Coordinated Attacks of the same Attribute for up to 1 time(s) every 3s.","params":[{"label":"凌霄·普攻第一段伤害"