flowing Radiance is available within 5s.\nResonance Skill Overflowing Radiance inflicts Spectro DMG and sends Jinhsi into Incarnation.\nCan be cast in mid-air.","params":[{"label":"技能伤害","labelEn":"Skill DMG","values":["9.79%*4+39.15%","10.60%*4+42.37%","11.40%*4+45.58%","12.52%*4+50.07%","13.32%*4+53.28%","14.25%*4+56.97%","15.53%*4+62.11%","16.82%*4+67.25%","18.10%*4+72.38%","19.46%*4+77.84%"]},{"label":"神霓飞芒伤害","labelEn":"Overflowing Radiance DMG","values":["4.96%*4+14.88%*4+19.84%","5.37%*4+16.11%*4+21.47%","5.78%*4+17.33%*4+23.10%","6.35%*4+19.03%*4+25.38%","6.75%*4+20.25%*4+27.00%","7.22%*4+21.66%*4+28.87%","7.87%*4+23.61%*4+31.48%","8.52%*4+25.56%*4+34.08%","9.17%*4+27.51%*4+36.68%","9.87%*4+29.59%*4+39.45%"]},{"label":"乘岁凌霄状态持续时间","labelEn":"Incarnation Duration","values":["10","10","10","10","10","10","10","10","10","10"]},{"label":"冷却时间","labelEn":"Cooldown","values":["3","3","3","3","3","3","3","3","3","3"]},{"label":"神霓飞芒冷却时间","labelEn":"Overflowing Radiance Cooldown","values":["12","12","12","12","12","12","12","12","12","12"]},{"label":"神霓飞芒回复协奏能量","labelEn":"Overflowing Radiance Concerto Regen","values":["4","4","4","4","4","4","4","4","4","4"]}],"hits":[{"label":"技能伤害","labelEn":"Skill DMG","term":0,"count":4,"multiplier":[0.0979,0.106,0.114,0.1252,0.1332,0.1425,0.1553,0.1682,0.181,0.1946],"damageId":1304200001,"type":"skill","typeId":4,"typeName":"共鸣技能","calc":"damage","element":"spectro","elementId":5,"scaling":"atk","rateField":"RateLv","flat":null,"energy":[0.28],"concerto":[0.55],"elementPowerType":5,"toughness":[0.25],"offTune":[0.087],"hardness":[1.0],"formulaType":0,"subType":[],"damageIds":[1304200001,1304200002,1304200003,1304200004],"variants":[{"damageId":1304200002,"type":"skill","typeId":4,"element":"spectro","scaling":"atk","flat":null,"energy":[0.28],"concerto":[0.55],"toughness":[0.25],"offTune":[0.087]},{"damageId":1304200003,"type":"skill","typeId":4,"element":"spectro","scaling":"atk","flat":null,"energy":[0.28],"concerto":[0.55],