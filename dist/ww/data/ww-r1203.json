tack after a successful Dodge to attack the target, dealing Fusion DMG, considered as Basic Attack DMG.","params":[{"label":"黑咩·胡闹第一段伤害","labelEn":"Cosmos: Frolicking Stage 1 DMG","values":["45.36%*2","49.08%*2","52.80%*2","58.01%*2","61.73%*2","66.01%*2","71.96%*2","77.91%*2","83.86%*2","90.18%*2"]},{"label":"黑咩·胡闹第二段伤害","labelEn":"Cosmos: Frolicking Stage 2 DMG","values":["28.37%*3","30.70%*3","33.02%*3","36.28%*3","38.61%*3","41.28%*3","45.00%*3","48.72%*3","52.45%*3","56.40%*3"]},{"label":"黑咩·胡闹第三段伤害","labelEn":"Cosmos: Frolicking Stage 3 DMG","values":["33.19%*4","35.92%*4","38.64%*4","42.45%*4","45.17%*4","48.30%*4","52.65%*4","57.01%*4","61.36%*4","65.99%*4"]},{"label":"黑咩·胡闹第四段伤害","labelEn":"Stage 4 DMG","values":["97.59%*3","105.59%*3","113.59%*3","124.79%*3","132.79%*3","142.00%*3","154.80%*3","167.60%*3","180.40%*3","194.01%*3"]},{"label":"黑咩·重击伤害","labelEn":"Cosmos: Heavy Attack DMG","values":["109.44%","118.42%","127.39%","139.96%","148.93%","159.25%","173.61%","187.97%","202.32%","217.58%"]},{"label":"黑咩·狂热伤害","labelEn":"Cosmos Rampage Damage","values":["31.85%*4","34.46%*4","37.07%*4","40.72%*4","43.34%*4","46.34%*4","50.52%*4","54.70%*4","58.88%*4","63.32%*4"]},{"label":"黑咩·闪避反击伤害","labelEn":"Cosmos: Dodge Counter DMG","values":["33.19%*4","35.92%*4","38.64%*4","42.45%*4","45.17%*4","48.30%*4","52.65%*4","57.01%*4","61.36%*4","65.99%*4"]},{"label":"黑咩·重击耐力消耗","labelEn":"Cosmos: Heavy Attack STA Cost","values":["25","25","25","25","25","25","25","25","25","25"]},{"label":"黑咩大暴走持续时间","labelEn":"Cosmos Rave Duration","values":["10","10","10","10","10","10","10","10","10","10"]},{"label":"冷却时间","labelEn":"Cooldown","values":["16","16","16","16","16","16","16","16","16","16"]},{"label":"黑咩·狂热冷却时间","labelEn":"Cosmos Rampage Cooldown","values":["4","4","4","4","4","4","4","4","4","4"]},{"label":"消耗共鸣能量","labelEn":"Resonance Cost","values":["125","125","125","125","125","125","125","125","125","125"]},{"label":"回复协奏能量","labelEn":"Concerto Regen","values":["2